# Environment Variables for Leafy Expo App

# Convex Backend
# Get your Convex URL from https://dashboard.convex.dev
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site
CONVEX_DEPLOYMENT=dev:your-deployment|your-token

# API URL for tRPC
EXPO_PUBLIC_API_URL=http://localhost:3000/api/trpc
